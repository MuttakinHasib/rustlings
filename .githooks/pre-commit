#!/bin/sh
# Keep the exercise completion status in README.md in sync via `rustlings check-all`.
cd "$(git rev-parse --show-toplevel)" || exit 0
[ -f README.md ] || exit 0

out=$(rustlings check-all 2>&1 | perl -pe 's/\e\][^\e]*\e\\//g; s/\e\[[0-9;?]*[a-zA-Z]//g')

summary=$(printf '%s\n' "$out" | grep -oE '[0-9]+/[0-9]+ exercises pending' | tail -n 1)
if [ -n "$summary" ]; then
  pending=${summary%%/*}
  total=${summary#*/}
  total=${total%% *}
elif printf '%s\n' "$out" | grep -qiE 'congratulations|all exercises (are )?(done|completed|passed)'; then
  # Wording variant when everything passes
  pending=0
  total=$(find exercises -name '*.rs' | wc -l | tr -d ' ')
else
  exit 0
fi

completed=$((total - pending))
if [ "$pending" -eq 0 ]; then
  line="**Status:** $completed/$total exercises completed ✅"
else
  line="**Status:** $completed/$total exercises completed"
fi

perl -pi -e "s|^\*\*Status:\*\* .*$|$line|" README.md
git add README.md
